  "description": "SHIP-OS MCP server: exposes SHIP-OS as MCP tools over the existing JSON API (/api/v1/mobile/*) with desktop-link session auth.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "shipos-mcp": "dist/index.js"
